# --- GitHub（未ログイン時の公開リポジトリ取得用。未設定でも動くがレートリミットが60req/hになる） ---
GITHUB_TOKEN=

# --- Vertex AI（GCP_PROJECT が空ならモック応答になる） ---
GCP_PROJECT=
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# --- Firebase Authentication / Firestore ---
# 空なら認証・履歴保存は無効のまま、公開リポジトリの利用だけができる
FIREBASE_PROJECT_ID=
FIRESTORE_ENABLED=true

# --- GitHub App（プライベートリポジトリ用。空ならログインしてもprivateは読めない） ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM全文。改行を含むため .env では引用符で囲むこと
GITHUB_APP_PRIVATE_KEY=

# --- Cloud KMS（GitHubユーザートークンの暗号化。空なら保存をスキップする） ---
# 例: projects/<PROJECT>/locations/global/keyRings/repo-educator/cryptoKeys/github-token
KMS_KEY_NAME=

# --- フロントエンド（CORS許可オリジンとインストール後のリダイレクト先。カンマ区切りで複数可） ---
# 空なら '*'（全許可）。`flutter run -d chrome` はポートが毎回変わるため開発中はこのままでよい。
# 本番では必ず Firebase Hosting のドメインを指定すること。
FRONTEND_ORIGIN=

# --- GitHub App インストール時のstate署名鍵（空ならプロセス起動ごとにランダム生成） ---
STATE_SECRET=
