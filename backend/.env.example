# --- Gemini（Gemini Developer API。APIキー1本で使う。空ならモック応答になる） ---
# https://aistudio.google.com/apikey で発行する。GCPプロジェクトは不要。
GEMINI_API_KEY=

# 使用するGeminiモデル。空なら gemini-3.5-flash。
# Geminiのモデルは定期的に廃止されるため、コードを変えずに差し替えられるようにしている。
GEMINI_MODEL=

# --- データベース（ログイン機能・学習履歴・解析結果キャッシュに使う） ---
# 空なら以下すべてが無効のまま、公開リポジトリの利用だけができる。
# PostgreSQL互換なら何でもよい。ローカルはdocker-composeのpostgresサービスを既定値にしている。
# Neon等のマネージドサービスを使う場合は接続文字列を丸ごと差し替える。
#   例: postgresql+asyncpg://user:pass@ep-xxxx.neon.tech/dbname?ssl=require
DATABASE_URL=postgresql+asyncpg://repo_educator:repo_educator@db:5432/repo_educator

# --- 認証（自前のID/パスワード認証。JWTで発行する） ---
# 空ならログイン機能自体が無効になる。ランダムな文字列を設定すること。
# 生成例: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_EXPIRES_DAYS=30

# --- ユーザーが入力したGitHub PATの暗号化鍵。空なら保存自体をスキップする ---
# 生成例: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- フロントエンド（CORS許可オリジン。カンマ区切りで複数可） ---
# 空なら '*'（全許可）。`flutter run -d chrome` はポートが毎回変わるため開発中はこのままでよい。
# 本番ではフロントエンドの配信ドメインを指定すること。
FRONTEND_ORIGIN=
